<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/brand2</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/textDim</item>
    </style>

    <style name="SectionLabel">
        <item name="android:textSize">10.5sp</item>
        <item name="android:textColor">@color/textFaint</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
